{
  "name": "hithadshut-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:content": "bash scripts/content-lint.sh",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run typecheck && npm run lint && npm run build",
    "indexnow": "tsx scripts/submit-to-indexnow.ts",
    "gsc-ping": "tsx scripts/gsc-ping.ts",
    "install-hooks": "bash scripts/install-hooks.sh",
    "postinstall": "bash scripts/install-hooks.sh || true"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "next": "16.2.3",
    "next-sitemap": "^4.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
