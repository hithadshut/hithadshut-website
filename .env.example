# Copy to .env.local (gitignored) and fill in real values.
# In production, set the same vars in Vercel Project Settings.

# --- Email delivery (primary channel) ---
# Resend API key — https://resend.com → Settings → API Keys
RESEND_API_KEY=

# Envelope "From" address. Options:
#   1) Hithadshut <onboarding@resend.dev>     (works instantly, no DNS setup)
#   2) Hithadshut <leads@hithadshut.co.il>    (requires domain verified in Resend)
# Start with option 1, switch to option 2 once DNS SPF/DKIM is verified.
LEAD_FROM_EMAIL=Hithadshut <onboarding@resend.dev>

# --- Optional webhook backup (secondary channel) ---
# Post every lead to an external webhook (Zapier/Make/Slack). If set, the
# /api/lead route forwards there in addition to email. Leave empty to skip.
LEAD_WEBHOOK_URL=
